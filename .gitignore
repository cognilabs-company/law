# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client docs / TZ / spec — never commit
*.docx
*.xlsx
*.pdf
/lex/

# Telegram MD bot — local state, never commit
/tools/mdbot/subscribers.json
/tools/mdbot/.offset

/public/mediapipe/wasm/

# Working notes, briefs and reference material — kept locally, never commit
/md/
/format-file/
/view-img/
/*.md
!/README.md
!/AGENTS.md
!/CLAUDE.md
/public/img/advokat-yuristlar.png
/public/img/demo-advokat.png
/public/img/demo-yurist.png
/public/img/tasdiqlovchi-icon.png
