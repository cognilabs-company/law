+class PiiVault:
+    """Collects the PII spans found while masking outbound text for one AI
+    turn, each behind a unique, reversible token — so `unmask()` can restore
+    the real values in the AI's reply afterwards. Create one per request/turn
+    (`run_ai`, `run_seller_ai`, …); never share or persist it, the tokens are
+    only meaningful within that single round trip."""
+
+    def __init__(self) -> None:
+        self._by_token: dict[str, str] = {}
+        self._by_value: dict[str, str] = {}
+        self._next = 1
+
+    def _token_for(self, original: str, kind: str) -> str:
+        existing = self._by_value.get(original.lower())
+        if existing:
+            return existing
+        token = f"[{kind}_{self._next}]"
+        self._next += 1
+        self._by_token[token] = original
+        self._by_value[original.lower()] = token
+        return token
+
+    def mask(self, value: str, known_terms: list[str] | None = None) -> str:
+        if not value:
+            return value
+        masked = value
+        # Longest known term first, so "Aziz Karimov" is masked whole before
+        # a bare "Aziz" inside it could match on its own.
+        for term in sorted({t.strip() for t in (known_terms or []) if t and len(t.strip()) >= 3}, key=len, reverse=True):
+            masked = re.sub(re.escape(term), lambda m, t=term: self._token_for(t, "NAME"), masked, flags=re.IGNORECASE)
+        for pattern, kind in PII_PATTERNS:
+            masked = pattern.sub(lambda m, k=kind: self._token_for(m.group(0), k), masked)
+        return masked
+
+    def unmask(self, value: str) -> str:
+        if not value:
+            return value
+        restored = value
+        for token, original in self._by_token.items():
+            restored = restored.replace(token, original)
+        return restored
+
+
+def name_terms_for(user) -> list[str]:
+    """The known-name strings for an authenticated user (None for a guest),
+    longest first — exactly what PiiVault.mask needs for the NAME pass."""
+    if not user:
+        return []
+    full = " ".join(filter(None, [getattr(user, "first_name", None), getattr(user, "last_name", None), getattr(user, "middle_name", None)])).strip()
+    candidates = [getattr(user, "name", None), full, getattr(user, "first_name", None), getattr(user, "last_name", None), getattr(user, "middle_name", None)]
+    seen: set[str] = set()
+    terms: list[str] = []
+    for c in candidates:
+        c = (c or "").strip()
+        if len(c) >= 3 and c.lower() not in seen:
+            seen.add(c.lower())
+            terms.append(c)
+    return terms
+
+
+# Back-compat: a one-off mask with no restore (fine for a fire-and-forget
+# audit-log line, e.g. add_activity(...); never use this where the masked
+# text is sent to the AI and the reply is shown to the user — use a
+# PiiVault there so the reply can be unmasked).
+def mask_pii(value: str, known_terms: list[str] | None = None) -> str:
+    return PiiVault().mask(value, known_terms)
 
 
