     record = MarketplaceRecord(module="ai_case_tool", record_type=tool, title=f"{tool} {case.case_number}", status="draft", owner_user_id=user.id, payload_json=dump_json({"case_id": case.id, "tool": tool, "result": result, "source_file_ids": [row.id for row in case_files], "editable": True}))
     db.add(record)
     add_activity(db, user.id, "ai_case_tool", tool, "", {"case_id": case.id, "result_id": record.id}, "legal_case", case.id)
