diff --git a/tests/test_pii_masking.py b/tests/test_pii_masking.py
new file mode 100644
index 0000000..e02c2d7
--- /dev/null
+++ b/tests/test_pii_masking.py
@@ -0,0 +1,85 @@
+import unittest
+
+from ai_service import PiiVault, mask_pii, name_terms_for
+
+
+# GM v1.1 acceptance test text (T0-17): a client message carrying every
+# category requirement #1 lists — name, PINFL, passport, phone, address,
+# bank card.
+SAMPLE = (
+    "Mening ismim Aziz Karimov, JShShIRim 31234567890123, pasportim AB1234567, "
+    "telefonim +998 90 123 45 67, manzilim Toshkent sh., Chilonzor 5-kvartal "
+    "12-uy, kartam 8600 1234 5678 9012. Qarzdorim pulni qaytarmayapti, nima qilay?"
+)
+
+
+class FakeUser:
+    def __init__(self, name, first_name="", last_name="", middle_name=""):
+        self.name = name
+        self.first_name = first_name
+        self.last_name = last_name
+        self.middle_name = middle_name
+
+
+class MaskPiiTests(unittest.TestCase):
+    def test_phone_pinfl_passport_bank_card_are_masked(self):
+        masked = mask_pii(SAMPLE)
+        self.assertNotIn("31234567890123", masked)
+        self.assertNotIn("AB1234567", masked)
+        self.assertNotIn("+998 90 123 45 67", masked)
+        self.assertNotIn("8600 1234 5678 9012", masked)
+
+    def test_address_keyword_is_masked(self):
+        masked = mask_pii(SAMPLE)
+        # The literal address fragments should not survive verbatim.
+        self.assertNotIn("Chilonzor 5-kvartal 12-uy", masked)
+
+    def test_no_known_name_leaves_the_name_unmasked(self):
+        # mask_pii with no known_terms has no way to find a free-text name —
+        # this documents the limitation rather than a false expectation.
+        masked = mask_pii(SAMPLE)
+        self.assertIn("Aziz Karimov", masked)
+
+    def test_known_name_is_masked(self):
+        vault = PiiVault()
+        masked = vault.mask(SAMPLE, ["Aziz Karimov"])
+        self.assertNotIn("Aziz Karimov", masked)
+
+    def test_name_terms_for_user(self):
+        user = FakeUser(name="Aziz Karimov", first_name="Aziz", last_name="Karimov")
+        terms = name_terms_for(user)
+        self.assertIn("Aziz Karimov", terms)
+        self.assertIn("Aziz", terms)
+        self.assertIn("Karimov", terms)
+
+    def test_name_terms_for_guest_is_empty(self):
+        self.assertEqual(name_terms_for(None), [])
+
+    def test_round_trip_restores_the_original_value_in_a_reply(self):
+        # Requirement #2: once the (masked) request comes back from the
+        # external AI, the original values must be restored for the user —
+        # this was entirely unimplemented before this fix (fixed placeholder
+        # strings had no way back to the real value).
+        vault = PiiVault()
+        masked = vault.mask(SAMPLE, ["Aziz Karimov"])
+        name_token = next(tok for tok in masked.split() if tok.startswith("[NAME_"))
+        # Strip any trailing punctuation the split() may have caught.
+        name_token = name_token[: name_token.index("]") + 1]
+        simulated_ai_reply = f"Salom {name_token}! Sizning holatingizda ..."
+        restored = vault.unmask(simulated_ai_reply)
+        self.assertIn("Aziz Karimov", restored)
+        self.assertNotIn("[NAME_", restored)
+
+    def test_repeated_value_reuses_the_same_token(self):
+        # The same PII value appearing twice must map to one token, not two —
+        # otherwise the reply could restore the second occurrence with the
+        # wrong original value.
+        vault = PiiVault()
+        text = "Tel: +998 90 123 45 67. Yana bir bor: +998 90 123 45 67."
+        masked = vault.mask(text)
+        tokens = [w for w in masked.replace(".", " ").split() if w.startswith("[PHONE_")]
+        self.assertEqual(len(set(tokens)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
